<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ch.hftm.oop2_winget_project.Controller.PackageListController">
    <center>
        <TableView fx:id="tableView_packages" prefHeight="200.0" styleClass="tableView_packages" stylesheets="@../CSS/DarkTheme.css" BorderPane.alignment="TOP_LEFT">
            <columns>
                <TableColumn editable="false" maxWidth="30.0" minWidth="-Infinity" prefWidth="30.0" resizable="false" sortable="false" />
                <TableColumn fx:id="column_name" editable="false" minWidth="300.0" prefWidth="-1.0" reorderable="false" resizable="false" text="Name" />
                <TableColumn fx:id="column_id" editable="false" minWidth="300.0" prefWidth="-1.0" reorderable="false" resizable="false" text="ID" />
                <TableColumn fx:id="column_version" editable="false" minWidth="300.0" prefWidth="-1.0" reorderable="false" resizable="false" text="Version" />
                <TableColumn fx:id="column_source" editable="false" minWidth="150.0" prefWidth="-1.0" reorderable="false" resizable="false" text="Source" />
                <TableColumn fx:id="column_install" editable="false" minWidth="130.0" prefWidth="-1.0" resizable="false" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>
    </center>
   <top>
      <BorderPane prefHeight="50.0" BorderPane.alignment="CENTER">
         <right>
                <HBox prefHeight="200.0" spacing="20.0" BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="button_removePackageFromList" mnemonicParsing="false" onAction="#button_removePackageFromList" styleClass="deleteButton" stylesheets="@../CSS/DarkTheme.css" text="Remove Selected Item" />
                        <TextField fx:id="textField_filter" promptText="Filter Packages" stylesheets="@../CSS/DarkTheme.css" />
                        <ComboBox fx:id="comboBox_filter" prefWidth="150.0" stylesheets="@../CSS/DarkTheme.css" />
                    </children>
               <padding>
                  <Insets left="5.0" right="25.0" top="9.0" />
               </padding>
                </HBox>
         </right>
         <left>
                  <Label fx:id="label_title" styleClass="label-title" stylesheets="@../CSS/DarkTheme.css" BorderPane.alignment="CENTER" />
         </left>
      </BorderPane>
   </top>
</BorderPane>
